---
// Warm up set calculator UI. Logic lives in src/lib/warmup.js and src/lib/plates.js (tested by npm test).
// The first paint (225 lb, strength ramp) is built here, so the page has content before any script runs.
import site from '../site.config.ts';
import { DEFAULT_PLATES } from '../lib/plates.js';
import { PRESETS, buildWarmups } from '../lib/warmup.js';
import { rowsHtml, rampLine, chipsHtml, barGroupHtml, plateGroupHtml, roundGroupHtml } from '../lib/render.js';

const first = buildWarmups({ work: 225, bar: 45, plates: DEFAULT_PLATES.lb, steps: PRESETS.strength.steps, step: 5, minGap: PRESETS.strength.minGap.lb });
const presetList = [...Object.entries(PRESETS).map(([id, p]) => ({ id, label: p.label })), { id: 'custom', label: 'Custom' }];
---
<section id="tool" aria-label="Warm up set calculator" data-domain={site.domain} class="rounded-2xl border border-line bg-card p-4 sm:p-6 sm:shadow-[6px_6px_0_0_var(--line)]">
  <noscript><p class="mb-4 rounded-xl bg-brand-soft p-3 text-sm">The calculator needs JavaScript to change the weight. The table below shows a ramp for 225 lb, and the tables further down the page list common weights.</p></noscript>
  <div class="flex flex-col gap-6 md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] md:items-start md:gap-8">

    <!-- Inputs. On a phone the weight and preset come first, then the result, then the settings. -->
    <div class="contents md:block md:space-y-6 print:hidden">
      <div class="order-1 space-y-5 md:order-none">
        <fieldset>
          <legend class="mb-2 text-sm font-semibold">Units</legend>
          <div class="grid grid-cols-2 gap-2" id="unit-group">
            <label class="seg"><input type="radio" name="unit" value="lb" class="peer sr-only" checked /><span class="seg-face">Pounds (lb)</span></label>
            <label class="seg"><input type="radio" name="unit" value="kg" class="peer sr-only" /><span class="seg-face">Kilograms (kg)</span></label>
          </div>
        </fieldset>

        <div>
          <label for="work" class="mb-2 block text-sm font-semibold">Work weight, bar included <span id="unit-label" class="font-normal text-muted">(lb)</span></label>
          <div class="flex items-stretch gap-2">
            <button type="button" id="dec" class="step" aria-label="Subtract one step from the work weight">&minus;</button>
            <input id="work" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" enterkeyhint="done" value="225" aria-describedby="result-status"
              class="h-14 min-w-0 flex-1 rounded-xl border border-edge bg-paper px-3 text-center font-mono text-3xl font-bold tabular-nums outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 aria-[invalid=true]:border-red-600" />
            <button type="button" id="inc" class="step" aria-label="Add one step to the work weight">+</button>
          </div>
          <div id="chips" class="mt-2 flex flex-wrap gap-2" role="group" aria-label="Common work weights" set:html={chipsHtml('lb')}></div>
        </div>

        <fieldset>
          <legend class="mb-2 text-sm font-semibold">Warm up style</legend>
          <div class="grid grid-cols-2 gap-2" id="preset-group">
            {presetList.map((p) => (
              <label class="seg"><input type="radio" name="preset" value={p.id} class="peer sr-only" checked={p.id === 'strength'} /><span class="seg-face">{p.label}</span></label>
            ))}
          </div>
          <p id="preset-note" class="mt-2 min-h-[2.5rem] text-sm text-muted">{PRESETS.strength.note}</p>
          <div id="custom-wrap" class="mt-1 hidden">
            <label for="custom-pcts" class="mb-1 block text-sm font-semibold">Percents of the work weight</label>
            <input id="custom-pcts" type="text" inputmode="text" autocomplete="off" autocapitalize="off" spellcheck="false" value="40, 60, 80" aria-describedby="custom-help"
              class="h-12 w-full rounded-xl border border-edge bg-paper px-3 font-mono text-lg font-semibold tabular-nums outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 aria-[invalid=true]:border-red-600" />
            <p id="custom-help" class="mt-1 text-xs text-muted">Numbers from 1 to 99, up to 8, separated by commas or spaces.</p>
            <p id="custom-note" role="status" class="mt-1 text-xs font-medium text-brand-ink empty:hidden"></p>
          </div>
        </fieldset>
      </div>

      <div class="order-3 space-y-5 md:order-none">
        <fieldset>
          <legend class="mb-2 text-sm font-semibold">Bar</legend>
          <div class="flex flex-wrap gap-2" id="bar-group" set:html={barGroupHtml('lb', '45')}></div>
          <div id="custom-bar-wrap" class="mt-2 hidden items-center gap-2">
            <label for="custom-bar" class="text-sm text-muted">Bar weight</label>
            <input id="custom-bar" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" value="25"
              class="h-12 w-28 rounded-xl border border-edge bg-paper px-3 text-center font-mono text-lg font-semibold tabular-nums outline-none focus:border-brand focus:ring-2 focus:ring-brand/30 aria-[invalid=true]:border-red-600" />
            <span id="custom-bar-unit" class="text-sm text-muted">lb</span>
          </div>
        </fieldset>

        <fieldset>
          <legend class="mb-1 text-sm font-semibold">Plates you have</legend>
          <p class="mb-2 text-sm text-muted">Tap to turn a plate off if your gym does not have it.</p>
          <div id="plate-group" class="flex flex-wrap gap-2" set:html={plateGroupHtml('lb', DEFAULT_PLATES.lb)}></div>
        </fieldset>

        <fieldset>
          <legend class="mb-1 text-sm font-semibold">Round each warm up set to</legend>
          <p class="mb-2 text-sm text-muted">The weight is rounded first, then matched to the closest load your plates make.</p>
          <div class="flex flex-wrap gap-2" id="round-group" set:html={roundGroupHtml('lb', 5)}></div>
        </fieldset>
      </div>
    </div>

    <!-- Result -->
    <div class="order-2 min-w-0 md:order-none md:sticky md:top-20 print:static">
      <div id="print-head" class="hidden print:block">
        <p id="print-title" class="text-2xl font-bold">Warm up sets</p>
        <p id="print-sub" class="mb-3 text-sm"></p>
      </div>
      <div class="min-h-[10.5rem] rounded-xl bg-brand-soft p-4 print:hidden" id="result-box">
        <p class="text-sm font-semibold uppercase tracking-wide text-brand-ink">Your warm up</p>
        <p id="ramp-line" class="mt-1 min-h-[2.75rem] break-words font-mono text-xl font-bold leading-snug tabular-nums sm:text-2xl">{rampLine(first, 'lb')}</p>
        <p id="result-status" role="status" aria-live="polite" class="mt-2 min-h-[3rem] text-base font-medium">Empty bar, {first.rows.length - 2} warm up sets, then your 225&nbsp;lb work set. Bar 45&nbsp;lb.</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" id="copy" class="alt-btn">Copy as text</button>
          <button type="button" id="print" class="alt-btn">Print</button>
        </div>
      </div>

      <div id="table-wrap" class="mt-4 overflow-x-auto rounded-xl border border-line print:mt-0" style="min-height:var(--table-h,20rem)">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Warm up sets: weight, plates per side and reps for each set, ending with the work set</caption>
          <thead class="bg-brand-soft text-xs uppercase tracking-wide text-brand-ink">
            <tr><th scope="col" class="px-2.5 py-2 font-semibold sm:px-3">Set</th><th scope="col" class="px-2.5 py-2 font-semibold sm:px-3">Weight</th><th scope="col" class="px-2.5 py-2 font-semibold sm:px-3">Plates per side</th><th scope="col" class="px-2.5 py-2 font-semibold sm:px-3">Reps</th></tr>
          </thead>
          <tbody id="warm" class="divide-y divide-line" set:html={rowsHtml(first, 'lb')}></tbody>
        </table>
      </div>
      <p id="warm-note" class="mt-2 min-h-[2.25rem] text-xs text-muted">Plates per side are for one end of the bar. Load the other end the same way. Rep counts are a guide, not a rule.</p>
      <p id="copy-status" role="status" aria-live="polite" class="min-h-[1rem] text-xs text-muted print:hidden"></p>
    </div>
  </div>
</section>

<!-- Phone only: keeps the ramp in view when the result box has scrolled away. -->
<button type="button" id="sticky-bar" hidden class="sticky-bar print:hidden" aria-label="Warm up sets. Tap to see the table.">
  <span class="sticky-label">Warm up</span>
  <span id="sticky-ramp" class="sticky-ramp">{rampLine(first, 'lb')}</span>
</button>

<style is:global>
  .seg-face { display:flex; min-height:3rem; align-items:center; justify-content:center; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); padding:.5rem .9rem; font-weight:600; font-size:.95rem; cursor:pointer; text-align:center; transition:background-color .12s,border-color .12s; user-select:none; }
  .seg-face:hover { border-color: var(--brand); }
  .peer:checked + .seg-face { background: var(--brand); border-color: var(--brand); color:#fff; }
  .peer:focus-visible + .seg-face { outline:2px solid var(--brand-ink); outline-offset:2px; }
  .step { width:3.5rem; flex:none; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); font-size:1.75rem; font-weight:600; line-height:1; cursor:pointer; }
  .step:hover { border-color: var(--brand); }
  .step:active { background: var(--brand-soft); }
  .chip { min-height:2.75rem; min-width:3.25rem; padding:.25rem .75rem; border-radius:999px; border:1px solid var(--edge); background:var(--paper); font-weight:600; font-size:.9rem; font-variant-numeric:tabular-nums; cursor:pointer; }
  .chip:hover { border-color: var(--brand); }
  .plate-pill { display:flex; min-height:3rem; align-items:center; gap:.5rem; border-radius:.75rem; border:1px solid var(--edge); background:var(--paper); padding:.35rem .8rem .35rem .6rem; font-weight:600; font-size:.95rem; cursor:pointer; user-select:none; font-variant-numeric:tabular-nums; }
  .plate-pill .dot { width:1.25rem; height:1.25rem; border-radius:999px; border:2px solid rgba(0,0,0,.35); flex:none; }
  .peer:not(:checked) + .plate-pill { opacity:.72; text-decoration:line-through; text-decoration-color: var(--muted); }
  .peer:not(:checked) + .plate-pill .dot { filter:grayscale(1); opacity:.5; }
  .peer:checked + .plate-pill { border-color: var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
  .peer:focus-visible + .plate-pill { outline:2px solid var(--brand-ink); outline-offset:2px; }
  .alt-btn { min-height:2.75rem; padding:.4rem .9rem; border-radius:.75rem; border:1px solid var(--brand); background:var(--card); font-weight:600; font-size:.95rem; color:var(--brand-ink); cursor:pointer; }
  .alt-btn:hover { background: var(--brand); color:#fff; }
  .sticky-bar { position:fixed; left:0; right:0; bottom:0; z-index:30; display:none; align-items:center; gap:.75rem; width:100%; min-height:3.25rem; padding:.55rem 1rem calc(.55rem + env(safe-area-inset-bottom)); border:0; border-top:2px solid var(--edge); background:var(--brand-soft); color:var(--ink); text-align:left; cursor:pointer; touch-action:manipulation; }
  .sticky-bar:not([hidden]) { display:flex; }
  .sticky-label { flex:none; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:var(--brand-ink); }
  .sticky-ramp { min-width:0; font-family:var(--font-mono); font-size:1rem; font-weight:700; line-height:1.25; font-variant-numeric:tabular-nums; overflow-wrap:anywhere; }
  @media (min-width:768px) { .sticky-bar, .sticky-bar:not([hidden]) { display:none; } }
  .actual { display:block; font-size:.7rem; font-weight:500; color:var(--muted); letter-spacing:0; }
  .seg-face, .step, .chip, .plate-pill, .alt-btn { touch-action:manipulation; }
  .dot { width:1rem; height:1rem; display:inline-block; border-radius:999px; border:2px solid rgba(0,0,0,.35); flex:none; }
  .side-item { display:inline-flex; align-items:center; gap:.3rem; font-weight:600; white-space:nowrap; }
  .side-item small { font-size:.8rem; color:var(--muted); font-weight:600; }
  .work-row { background: var(--brand-soft); }
  .work-row th, .work-row td { font-weight:700; }
  @media print {
    @page { margin: 14mm; }
    html, body, #tool, #tool *:not(.dot) { background:#fff !important; color:#000 !important; box-shadow:none !important; text-shadow:none !important; }
    body::before { display:none !important; }
    header, footer, .sticky-bar { display:none !important; }
    main > *:not(:first-child), main > section:first-child > h1, main > section:first-child > p, main > section:first-child > aside { display:none !important; }
    main > section:first-child { padding-top:0 !important; }
    main > section:first-child > div { min-height:0 !important; margin-top:0 !important; }
    #tool { border:0 !important; padding:0 !important; }
    #tool > div { display:block !important; }
    #table-wrap { min-height:0 !important; border:2px solid #000 !important; border-radius:0 !important; }
    #tool table, #tool th, #tool td { border-color:#000 !important; font-size:14pt; }
    #tool thead th { border-bottom:2px solid #000 !important; }
    .actual { color:#000 !important; }
    #tool tr { border-color:#000 !important; }
    .work-row th, .work-row td { font-weight:800; }
    #warm-note { font-size:10pt; }
  }
</style>
<script>
  import { STEP, MAX_WORK, parseNumber, convertTarget, fmt } from '../lib/plates.js';
  import { PRESETS, ROUND_STEPS, MAX_PERCENTS, buildWarmups, parsePercents, allPercents } from '../lib/warmup.js';
  import { rowsHtml, rampLine, rowName, chipsHtml, barGroupHtml, plateGroupHtml, roundGroupHtml } from '../lib/render.js';
  import { loadState, DEFAULT_CUSTOM_BAR } from '../lib/state.js';

  type Unit = 'lb' | 'kg';
  const MAX_SIDE_PLATES = 10; // more than this on one sleeve is not a real load
  const KEY = 'warm-up-set-calc-v1'; // one origin is shared by all tools on GitHub Pages, so the key is specific
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const show = (id: string, on: boolean) => { $(id).classList.toggle('hidden', !on); $(id).classList.toggle('flex', on); };
  const domain = $('tool').dataset.domain || '';

  let saved: unknown = null;
  try { saved = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch {}
  const state = loadState(saved);
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(state)); } catch {} };

  // The last number the person chose, so a unit round trip returns to it (225 lb, 100 kg, 225 lb).
  let anchor = { unit: state.unit, work: state.work };
  let lastText = '';
  let tableRows = 0;

  const barWeight = () => {
    const id = state.bar[state.unit];
    return id === 'custom' ? state.customBar[state.unit] : Number(id);
  };
  const maxWork = () => MAX_WORK[state.unit];

  // Tell the person when extra custom percents are not used.
  function updateCustomNote() {
    const all = allPercents(state.custom);
    $('custom-note').textContent = all.length > MAX_PERCENTS ? `Only ${MAX_PERCENTS} percents are used. Left out: ${all.slice(MAX_PERCENTS).join(', ')}.` : '';
  }

  function buildStatic() {
    const u = state.unit;
    (document.querySelector(`input[name=unit][value=${u}]`) as HTMLInputElement).checked = true;
    (document.querySelector(`input[name=preset][value=${state.preset}]`) as HTMLInputElement).checked = true;
    $('unit-label').textContent = `(${u})`;
    $('custom-bar-unit').textContent = u;
    $<HTMLInputElement>('work').value = fmt(state.work);
    $<HTMLInputElement>('custom-bar').value = fmt(state.customBar[u]);
    $<HTMLInputElement>('custom-pcts').value = state.custom;
    updateCustomNote();
    $('chips').innerHTML = chipsHtml(u);
    $('bar-group').innerHTML = barGroupHtml(u, state.bar[u]);
    show('custom-bar-wrap', state.bar[u] === 'custom');
    $('plate-group').innerHTML = plateGroupHtml(u, state.plates[u]);
    $('round-group').innerHTML = roundGroupHtml(u, state.round[u]);
    $('custom-wrap').classList.toggle('hidden', state.preset !== 'custom');
    $('preset-note').textContent = state.preset === 'custom' ? 'Your own percents. Reps are not suggested.' : PRESETS[state.preset as keyof typeof PRESETS].note;
  }

  function currentSteps() {
    if (state.preset !== 'custom') return PRESETS[state.preset as keyof typeof PRESETS].steps;
    return [{ pct: 0, sets: 1, reps: 0 }, ...parsePercents(state.custom).map((pct) => ({ pct, sets: 1, reps: 0 }))];
  }

  function render() {
    const u = state.unit;
    const bar = barWeight();
    const work = state.work;
    const plates = state.plates[u];
    const status = $('result-status');
    const badBar = !(bar > 0);
    const custom = state.preset === 'custom';
    const pcts = custom ? parsePercents(state.custom) : [];
    const steps = currentSteps();
    const minGap = state.preset === 'custom' ? 0 : PRESETS[state.preset as keyof typeof PRESETS].minGap[u];

    // Keep the table height for this preset so the page does not jump while you type.
    const maxRows = steps.length + 1;
    $('table-wrap').style.setProperty('--table-h', `${(2.4 + maxRows * 2.75).toFixed(1)}rem`);

    $('warm-note').textContent = 'Plates per side are for one end of the bar. Load the other end the same way. Rep counts are a guide, not a rule.';
    let res: any = { status: 'empty', rows: [] };
    if (!badBar) res = buildWarmups({ work, bar, plates, steps, step: state.round[u], minGap });

    let line = '-';
    let text = '';
    if (badBar) text = 'Enter the bar weight to see the sets.';
    else if (res.status === 'empty') text = 'Enter a work weight above 0 to see the sets.';
    else if (res.status === 'noplates') text = 'Turn on at least one plate size.';
    else if (res.status === 'light') {
      text = work <= bar
        ? `Your work weight is at or under the bar (${fmt(bar)}\u00a0${u}). Lift the bar for your warm up.`
        : `Your plates cannot add weight to the ${fmt(bar)}\u00a0${u} bar at ${fmt(work)}\u00a0${u}. Turn on a smaller plate.`;
    }
    else {
      const ramp = res.rows.filter((r: any) => r.kind === 'ramp').length;
      const word = (n: number) => `${n} ${n === 1 ? 'warm up set' : 'warm up sets'}`;
      line = rampLine(res, u);
      text = res.status === 'exact'
        ? `Empty bar, ${word(ramp)}, then your ${fmt(res.work)}\u00a0${u} work set. Bar ${fmt(bar)}\u00a0${u}.`
        : `Your plates cannot make ${fmt(work)} ${u}. The closest load is ${fmt(res.work)} ${u}, so the ramp uses that. Bar ${fmt(bar)} ${u}.`;
      if (custom && !pcts.length) text += ' Add percents to get more sets.';
    }
    $('ramp-line').textContent = line;
    $('sticky-ramp').textContent = line;
    status.textContent = text;

    // Table
    tableRows = res.rows.length;
    $('warm').innerHTML = tableRows ? rowsHtml(res, u) : '<tr><td colspan="4" class="px-3 py-6 text-center text-muted">No sets to show yet.</td></tr>';
    const rounded = res.rows.some((r: any) => r.kind === 'ramp');
    if (rounded) $('warm-note').textContent += ` Each set is rounded to ${fmt(state.round[u])} ${u}, then to the closest load your plates make.`;
    // Too many plates on one side usually means the plate sizes that are on cannot make a clean load.
    const most = Math.max(0, ...res.rows.map((r: any) => r.list.reduce((a: number, p: any) => a + p.n, 0)));
    if (most > MAX_SIDE_PLATES) $('warm-note').textContent += ` Not enough plate sizes for a clean load: a set needs ${most} plates on each side, which is more than fits on most sleeves. Turn on bigger plates, or check the weight.`;

    // Print header and copy text
    const label = custom ? 'Custom' : PRESETS[state.preset as keyof typeof PRESETS].label;
    $('print-title').textContent = tableRows ? `Warm up sets for ${fmt(res.work)} ${u}` : 'Warm up sets';
    $('print-sub').textContent = `${label} style. Bar ${Number.isFinite(bar) ? fmt(bar) : '-'} ${u}. Rounded to ${fmt(state.round[u])} ${u}. ${domain}`;
    lastText = tableRows
      ? [`Warm up sets for ${fmt(res.work)} ${u} (bar ${fmt(bar)} ${u}, ${label} style)`,
         ...res.rows.map((r: any) => {
           const nm = rowName(r);
           const side = r.list.length ? r.list.map((p: any) => `${fmt(p.w)}${p.n > 1 ? ` x${p.n}` : ''}`).join(' + ') : 'empty bar';
           const reps = r.kind === 'work' || !r.reps ? '' : `, ${r.sets > 1 ? `${r.sets} x ` : ''}${r.reps} reps`;
           return `${nm}: ${fmt(r.total)} ${u} (${side}${r.list.length ? ' per side' : ''})${reps}`;
         }), domain].join('\n')
      : '';
    $('copy-status').textContent = '';
    save();
    syncBar();
  }

  function setWork(v: number) {
    if (!(v > 0)) return;
    state.work = Math.min(v, maxWork());
    anchor = { unit: state.unit, work: state.work };
    $<HTMLInputElement>('work').value = fmt(state.work);
    $('work').removeAttribute('aria-invalid');
    render();
  }
  const nudge = (dir: 1 | -1) => setWork(Math.max(STEP[state.unit], (state.work || 0) + dir * STEP[state.unit]));

  // Events
  const workEl = $<HTMLInputElement>('work');
  workEl.addEventListener('input', () => {
    const v = parseNumber(workEl.value);
    workEl.setAttribute('aria-invalid', String(workEl.value.trim() !== '' && !(v > 0)));
    state.work = v > 0 ? Math.min(v, maxWork()) : 0;
    if (v > maxWork()) workEl.value = fmt(maxWork());
    anchor = { unit: state.unit, work: state.work };
    render();
  });
  workEl.addEventListener('blur', () => { if (state.work > 0) { workEl.value = fmt(state.work); workEl.removeAttribute('aria-invalid'); } });
  workEl.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp') { e.preventDefault(); nudge(1); }
    if (e.key === 'ArrowDown') { e.preventDefault(); nudge(-1); }
  });
  $('inc').addEventListener('click', () => nudge(1));
  $('dec').addEventListener('click', () => nudge(-1));
  $('chips').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('button[data-w]') as HTMLElement | null;
    if (b) setWork(Number(b.dataset.w));
  });
  $('unit-group').addEventListener('change', (e) => {
    const to = (e.target as HTMLInputElement).value as Unit;
    if (to === state.unit) return;
    state.work = Math.min(anchor.unit === to && anchor.work > 0 ? anchor.work : convertTarget(state.work, state.unit, to), MAX_WORK[to]);
    state.unit = to;
    buildStatic(); render();
  });
  $('preset-group').addEventListener('change', (e) => {
    state.preset = (e.target as HTMLInputElement).value;
    buildStatic(); render();
  });
  const pctEl = $<HTMLInputElement>('custom-pcts');
  pctEl.addEventListener('input', () => {
    state.custom = pctEl.value.slice(0, 60);
    updateCustomNote();
    pctEl.setAttribute('aria-invalid', String(state.custom.trim() !== '' && parsePercents(state.custom).length === 0));
    render();
  });
  $('bar-group').addEventListener('change', (e) => {
    state.bar[state.unit] = (e.target as HTMLInputElement).value;
    show('custom-bar-wrap', state.bar[state.unit] === 'custom');
    render();
  });
  const barEl = $<HTMLInputElement>('custom-bar');
  barEl.addEventListener('input', () => {
    const v = parseNumber(barEl.value);
    state.customBar[state.unit] = v > 0 && v <= maxWork() ? v : NaN;
    barEl.setAttribute('aria-invalid', String(!Number.isFinite(state.customBar[state.unit])));
    render();
  });
  barEl.addEventListener('blur', () => {
    if (!Number.isFinite(state.customBar[state.unit])) { state.customBar[state.unit] = DEFAULT_CUSTOM_BAR[state.unit]; render(); }
    barEl.value = fmt(state.customBar[state.unit]);
    barEl.removeAttribute('aria-invalid');
  });
  $('plate-group').addEventListener('change', () => {
    state.plates[state.unit] = Array.from(document.querySelectorAll<HTMLInputElement>('input[name=plate]:checked')).map((i) => Number(i.value));
    render();
  });
  $('round-group').addEventListener('change', (e) => {
    state.round[state.unit] = Number((e.target as HTMLInputElement).value);
    render();
  });

  $('print').addEventListener('click', () => {
    if (!tableRows) { $('copy-status').textContent = 'Nothing to print yet.'; return; }
    window.print();
  });
  $('copy').addEventListener('click', async () => {
    const out = $('copy-status');
    if (!lastText) { out.textContent = 'Nothing to copy yet.'; return; }
    try { await navigator.clipboard.writeText(lastText); out.textContent = 'Copied. Paste it into your notes or a message.'; }
    catch {
      const ta = document.createElement('textarea');
      ta.value = lastText; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      let ok = false; try { ok = document.execCommand('copy'); } catch {}
      ta.remove();
      out.textContent = ok ? 'Copied. Paste it into your notes or a message.' : 'Copy did not work here. Select the table and copy it.';
    }
  });

  // Sticky result bar (phones). Show it while the tool is on screen and the result box has scrolled out of view.
  const stickyEl = $('sticky-bar');
  const boxEl = $('result-box');
  const toolEl = $('tool');
  let boxVisible = true;
  let toolVisible = false;
  const syncBar = () => { stickyEl.hidden = boxVisible || !toolVisible || !tableRows; };
  if ('IntersectionObserver' in window) {
    new IntersectionObserver((e) => { boxVisible = e[e.length - 1].isIntersecting; syncBar(); }).observe(boxEl);
    new IntersectionObserver((e) => { toolVisible = e[e.length - 1].isIntersecting; syncBar(); }, { threshold: 0 }).observe(toolEl);
  }
  stickyEl.addEventListener('click', () => $('table-wrap').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' }));

  buildStatic();
  render();
</script>
